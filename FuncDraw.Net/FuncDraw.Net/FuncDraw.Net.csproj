<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../funcscript/FuncScript/FuncScript.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Template/head.html" LogicalName="FuncDraw.Net.Template.head.html" />
    <EmbeddedResource Include="Template/script.js" LogicalName="FuncDraw.Net.Template.script.js" />
    <EmbeddedResource Include="Template/tail.html" LogicalName="FuncDraw.Net.Template.tail.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="Svg.Skia" Version="3.2.1" />
    <PackageReference Include="Typography.OpenFont" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="fonts/**/*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
